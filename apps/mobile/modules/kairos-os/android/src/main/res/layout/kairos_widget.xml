<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/kairos_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:paddingStart="18dp"
  android:paddingEnd="18dp"
  android:paddingTop="16dp"
  android:paddingBottom="14dp"
  android:background="@drawable/kairos_widget_bg">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
      android:layout_width="8dp"
      android:layout_height="8dp"
      android:contentDescription="@null"
      android:src="@drawable/kairos_widget_mark" />

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="8dp"
      android:letterSpacing="0.22"
      android:text="KAIROS"
      android:textColor="#8A8174"
      android:textSize="10sp" />
  </LinearLayout>

  <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="14dp"
    android:text="Something I noticed"
    android:textColor="#C4A574"
    android:textSize="12sp" />

  <TextView
    android:id="@+id/kairos_widget_insight"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="6dp"
    android:layout_weight="1"
    android:ellipsize="end"
    android:lineSpacingExtra="3dp"
    android:maxLines="3"
    android:textColor="#F4EFE6"
    android:textSize="16sp" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/kairos_widget_capture"
      android:layout_width="0dp"
      android:layout_height="36dp"
      android:layout_weight="1"
      android:background="@drawable/kairos_widget_btn"
      android:clickable="true"
      android:focusable="true"
      android:gravity="center"
      android:text="Capture"
      android:textColor="#E8E0D4"
      android:textSize="13sp" />

    <TextView
      android:id="@+id/kairos_widget_ask"
      android:layout_width="0dp"
      android:layout_height="36dp"
      android:layout_marginStart="8dp"
      android:layout_weight="1"
      android:background="@drawable/kairos_widget_btn_ask"
      android:clickable="true"
      android:focusable="true"
      android:gravity="center"
      android:text="Ask"
      android:textColor="#1A140E"
      android:textSize="13sp" />
  </LinearLayout>
</LinearLayout>

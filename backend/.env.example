# Server
PORT=3000

# Clerk (server-side only — never commit real values)
CLERK_SECRET_KEY=sk_test_your-secret-key-here

# Neon PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Object storage (S3-compatible: AWS S3, Cloudflare R2, MinIO, etc.)
# Prefer STORAGE_PROVIDER=s3|r2 in production. Falls back to local if unset.
STORAGE_PROVIDER=s3
S3_BUCKET=your-bucket
S3_REGION=auto
S3_ENDPOINT=https://xxxxxxxx.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_FORCE_PATH_STYLE=true

# Local filesystem fallback (dev/tests only)
STORAGE_ROOT=./storage

# AI provider (OpenAI-compatible chat). Leave AI_API_KEY empty to skip AI analysis.
# OpenAI: AI_BASE_URL=https://api.openai.com/v1  AI_MODEL=gpt-4o-mini
# Groq:   AI_BASE_URL=https://api.groq.com/openai/v1
#         AI_MODEL=openai/gpt-oss-120b  (llama-3.3-70b-versatile was shut down 2026-08-16)
AI_PROVIDER=openai
AI_API_KEY=
# Optional extra Groq/OpenAI keys — on 429 the provider rotates to the next free key.
# AI_API_KEY_1=
# AI_API_KEY_2=
# AI_API_KEY_3=
# Or a single comma-separated list (also merges with AI_API_KEY / AI_API_KEY_N):
# AI_API_KEYS=gsk_xxx,gsk_yyy,gsk_zzz
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Max in-flight chat/completions. Default = number of configured AI keys (max 8).
# With 4 keys, unset this (or set 4) to process ~4 documents / Ask calls in parallel.
# AI_CHAT_CONCURRENCY=4
# Retries after the first attempt (default 4 → 5 total). Retries re-queue on the gate.
# AI_CHAT_MAX_RETRIES=4

# Embeddings (required for text chunks before COMPLETED)
# openai: OpenAI-compatible POST {EMBEDDING_BASE_URL}/embeddings
# gemini: Google Generative Language embedContent API (not OpenAI-shaped)
# local: deterministic vectors for plumbing tests only
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
# Gemini example:
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com
# EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_RETRIES=3

# Image OCR (Gemini multimodal). Defaults to gemini when EMBEDDING_API_KEY is set.
# OCR_PROVIDER=none disables OCR (metadata-only images).
OCR_PROVIDER=gemini
OCR_API_KEY=
OCR_BASE_URL=https://generativelanguage.googleapis.com
OCR_MODEL=gemini-2.5-flash

# Semantic search
SEARCH_MIN_SIMILARITY=0.2
SEARCH_MAX_PER_OBSERVATION=2

# Ask Kairos (RAG)
ASK_MAX_CHUNKS=6
ASK_MAX_CONTEXT_CHARS=8000
ASK_HISTORY_MAX_MESSAGES=8
ASK_HISTORY_MAX_CHARS=4000

# Recall (Android screen memory — derived text only; no raw screenshots)
RECALL_ENABLED=true
# Dev stub: grant all authenticated users active Recall entitlement
RECALL_STUB_GRANT_ALL=true
# Or set a default status when no DB row exists: inactive|trial|active|grace|expired|revoked
# RECALL_STUB_DEFAULT_STATUS=inactive
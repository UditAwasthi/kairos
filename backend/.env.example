# Server
PORT=3000

# Clerk (server-side only — never commit real values)
CLERK_SECRET_KEY=sk_test_your-secret-key-here

# Neon PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Object storage (S3-compatible: AWS S3, Cloudflare R2, MinIO, etc.)
# Prefer STORAGE_PROVIDER=s3|r2 in production. Falls back to local if unset.
STORAGE_PROVIDER=s3
S3_BUCKET=your-bucket
S3_REGION=auto
S3_ENDPOINT=https://xxxxxxxx.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_FORCE_PATH_STYLE=true

# Local filesystem fallback (dev/tests only)
STORAGE_ROOT=./storage

# AI provider (OpenAI-compatible). Leave AI_API_KEY empty to skip AI analysis.
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Embeddings (required for text chunks before COMPLETED)
# openai: OpenAI-compatible POST {EMBEDDING_BASE_URL}/embeddings
# gemini: Google Generative Language embedContent API (not OpenAI-shaped)
# local: deterministic vectors for plumbing tests only
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
# Gemini example:
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com
# EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_RETRIES=3

# Semantic search
SEARCH_MIN_SIMILARITY=0.2
SEARCH_MAX_PER_OBSERVATION=2

# Ask Kairos (RAG)
ASK_MAX_CHUNKS=6
ASK_MAX_CONTEXT_CHARS=8000
ASK_HISTORY_MAX_MESSAGES=8
ASK_HISTORY_MAX_CHARS=4000
// Kairos — observation understanding vertical slice.
// Full future model: docs/DATA_MODEL.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon: use the non-pooled connection for migrations
  directUrl = env("DIRECT_URL")
}

model User {
  id            String         @id @default(cuid())
  clerkUserId   String         @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  observations  Observation[]
  topics        Topic[]
  entities      Entity[]
  projects      Project[]
  conversations Conversation[]

  @@map("users")
}

enum ObservationType {
  DOCUMENT
  PDF
  IMAGE
  TEXT
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  EXTRACTING
  NORMALIZING
  CHUNKING
  ANALYZING
  EMBEDDING
  COMPLETED
  FAILED
}

enum EntityType {
  PERSON
  ORGANIZATION
  TECHNOLOGY
  PRODUCT
  LOCATION
  CONCEPT
}

model Observation {
  id               String                @id @default(cuid())
  userId           String
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type             ObservationType
  originalFilename String
  mimeType         String
  storageKey       String
  fileSizeBytes    Int
  processingStatus ProcessingStatus      @default(PENDING)
  extractedText    String?
  summary          String?
  processingError  String?
  sourceMetadata   Json?
  pageCount        Int?
  characterCount   Int?
  wordCount        Int?
  chunkCount       Int?
  capturedAt       DateTime              @default(now())
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  chunks              ObservationChunk[]
  observationTopics   ObservationTopic[]
  observationEntities ObservationEntity[]
  projectObservations ProjectObservation[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, processingStatus])
  @@map("observations")
}

model ObservationChunk {
  id             String                      @id @default(cuid())
  observationId  String
  observation    Observation                 @relation(fields: [observationId], references: [id], onDelete: Cascade)
  content        String
  chunkIndex     Int
  startOffset    Int?
  endOffset      Int?
  /// pgvector column; written/queried via raw SQL. Dimension must match EMBEDDING_DIMENSIONS.
  embedding      Unsupported("vector")?
  embeddingModel String?
  embeddedAt     DateTime?
  createdAt      DateTime                    @default(now())

  @@unique([observationId, chunkIndex])
  @@index([observationId])
  @@map("observation_chunks")
}

model Topic {
  id                String             @id @default(cuid())
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  normalizedName    String
  description       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  observationTopics ObservationTopic[]

  @@unique([userId, normalizedName])
  @@index([userId])
  @@map("topics")
}

model Entity {
  id                  String              @id @default(cuid())
  userId              String
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  normalizedName      String
  type                EntityType
  metadata            Json?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  observationEntities ObservationEntity[]

  @@unique([userId, normalizedName, type])
  @@index([userId])
  @@map("entities")
}

model ObservationTopic {
  observationId String
  topicId       String
  confidence    Float?
  createdAt     DateTime    @default(now())
  observation   Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)
  topic         Topic       @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([observationId, topicId])
  @@map("observation_topics")
}

model ObservationEntity {
  observationId String
  entityId      String
  confidence    Float?
  createdAt     DateTime    @default(now())
  observation   Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)
  entity        Entity      @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@id([observationId, entityId])
  @@map("observation_entities")
}

/// User-managed collection. Membership is independent of extraction/reprocessing.
model Project {
  id                  String               @id @default(cuid())
  userId              String
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  description         String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  projectObservations ProjectObservation[]

  @@index([userId, updatedAt(sort: Desc)])
  @@map("projects")
}

model ProjectObservation {
  projectId     String
  observationId String
  createdAt     DateTime    @default(now())
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  observation   Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)

  @@id([projectId, observationId])
  @@index([observationId])
  @@index([projectId, createdAt(sort: Desc)])
  @@map("project_observations")
}

enum ConversationMessageRole {
  USER
  ASSISTANT
}

enum ConversationMessageStatus {
  COMPLETED
  FAILED
}

model Conversation {
  id        String                @id @default(cuid())
  userId    String
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  messages  ConversationMessage[]

  @@index([userId, updatedAt(sort: Desc)])
  @@map("conversations")
}

model ConversationMessage {
  id                    String                     @id @default(cuid())
  conversationId        String
  conversation          Conversation               @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role                  ConversationMessageRole
  content               String
  status                ConversationMessageStatus  @default(COMPLETED)
  /// Validated citations only: [{observationId, chunkId, title, snippet, createdAt}]
  citations             Json?
  insufficientEvidence  Boolean?
  /// Client-supplied idempotency key for USER turns (unique per conversation when set).
  clientRequestId       String?
  createdAt             DateTime                   @default(now())

  @@unique([conversationId, clientRequestId])
  @@index([conversationId, createdAt])
  @@map("conversation_messages")
}
